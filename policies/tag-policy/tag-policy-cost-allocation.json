{
  "tags": {
    "Project": {
      "tag_key": { "@@assign": "Project" }
    },
    "Application": {
      "tag_key": { "@@assign": "Application" }
    },
    "Environment": {
      "tag_key": { "@@assign": "Environment" },
      "tag_value": {
